define double @test_double_live() gc "statepoint-example" {
; The hard-float ABI returns doubles in d0 and makes d8-d15 callee-saved
; ARM-LABEL: test_double_live:
; ARM:       @ %bb.0: @ %entry
; ARM-NEXT:    .save {r11, lr}
; ARM-NEXT:    push {r11, lr}
; ARM-NEXT:    .vsave {d8}
; ARM-NEXT:    vpush {d8}
; ARM-NEXT:    .pad #8
; ARM-NEXT:    sub sp, sp, #8
; ARM-NEXT:    bl return_double
; ARM-NEXT:    vorr d8, d0, d0
; ARM-NEXT:    vstr d0, [sp]
; ARM-NEXT:    bl return_double
; ARM-NEXT:  .Ltmp4:
; ARM-NEXT:    vadd.f64 d0, d0, d8
; ARM-NEXT:    add sp, sp, #8
; ARM-NEXT:    vpop {d8}
; ARM-NEXT:    pop {r11, pc}
;
; THUMB-LABEL: test_double_live:
; THUMB:       @ %bb.0: @ %entry
; THUMB-NEXT:    .save {r7, lr}
; THUMB-NEXT:    push {r7, lr}
; THUMB-NEXT:    .vsave {d8}
; THUMB-NEXT:    vpush {d8}
; THUMB-NEXT:    .pad #8
; THUMB-NEXT:    sub sp, #8
; THUMB-NEXT:    bl return_double
; THUMB-NEXT:    vorr d8, d0, d0
; THUMB-NEXT:    vstr d0, [sp]
; THUMB-NEXT:    bl return_double
; THUMB-NEXT:  .Ltmp4:
; THUMB-NEXT:    vadd.f64 d0, d0, d8
; THUMB-NEXT:    add sp, #8
; THUMB-NEXT:    vpop {d8}
; THUMB-NEXT:    pop {r7, pc}
entry:
  %arg = call double @return_double()
  %safepoint_token = call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 0, i32 0, ptr elementtype(double ()) @return_double, i32 0, i32 0, i32 0, i32 0) ["deopt" (double %arg)]
  %call1 = call double @llvm.experimental.gc.result.f64(token %safepoint_token)
  %sum = fadd double %call1, %arg
  ret double %sum
}

