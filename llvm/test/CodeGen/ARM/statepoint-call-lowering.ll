define void @test_indirect_target(ptr %fn) gc "statepoint-example" {
; An indirect call target is lowered to a BLX. That is 4 bytes in ARM mode and
; 2 bytes in Thumb mode
; ARM-LABEL: test_indirect_target:
; ARM:       @ %bb.0: @ %entry
; ARM-NEXT:    .save {r11, lr}
; ARM-NEXT:    push {r11, lr}
; ARM-NEXT:    blx r0
; ARM-NEXT:  .Ltmp9:
; ARM-NEXT:    pop {r11, pc}
;
; THUMB-LABEL: test_indirect_target:
; THUMB:       @ %bb.0: @ %entry
; THUMB-NEXT:    .save {r7, lr}
; THUMB-NEXT:    push {r7, lr}
; THUMB-NEXT:    blx r0
; THUMB-NEXT:  .Ltmp9:
; THUMB-NEXT:    pop {r7, pc}
entry:
  %safepoint_token = tail call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 0, i32 0, ptr elementtype(void ()) %fn, i32 0, i32 0, i32 0, i32 0)
  ret void
}

declare void @consume(ptr addrspace(1) %obj)

define i1 @test_cross_bb(ptr addrspace(1) %a, i1 %external_cond) gc "statepoint-example" {
; ARM-LABEL: test_cross_bb:
; ARM:       @ %bb.0: @ %entry
; ARM-NEXT:    .save {r4, r5, r6, lr}
; ARM-NEXT:    push {r4, r5, r6, lr}
; ARM-NEXT:    .pad #8
; ARM-NEXT:    sub sp, sp, #8
; ARM-NEXT:    mov r6, r1
; ARM-NEXT:    str r0, [sp, #4]
; ARM-NEXT:    mov r5, #1
; ARM-NEXT:    bl return_i1
; ARM-NEXT:  .Ltmp10:
; ARM-NEXT:    tst r6, #1
; ARM-NEXT:    beq .LBB10_2
; ARM-NEXT:  @ %bb.1: @ %left
; ARM-NEXT:    mov r4, r0
; ARM-NEXT:    ldr r0, [sp, #4]
; ARM-NEXT:    bl consume
; ARM-NEXT:    mov r5, r4
; ARM-NEXT:  .LBB10_2: @ %common.ret
; ARM-NEXT:    mov r0, r5
; ARM-NEXT:    add sp, sp, #8
; ARM-NEXT:    pop {r4, r5, r6, pc}
;
; THUMB-LABEL: test_cross_bb:
; THUMB:       @ %bb.0: @ %entry
; THUMB-NEXT:    .save {r4, lr}
; THUMB-NEXT:    push {r4, lr}
; THUMB-NEXT:    .pad #8
; THUMB-NEXT:    sub sp, #8
; THUMB-NEXT:    str r0, [sp, #4]
; THUMB-NEXT:    lsls r4, r1, #31
; THUMB-NEXT:    bl return_i1
; THUMB-NEXT:  .Ltmp10:
; THUMB-NEXT:    cbz r4, .LBB10_2
; THUMB-NEXT:  @ %bb.1: @ %left
; THUMB-NEXT:    ldr r1, [sp, #4]
; THUMB-NEXT:    mov r4, r0
; THUMB-NEXT:    mov r0, r1
; THUMB-NEXT:    bl consume
; THUMB-NEXT:    mov r0, r4
; THUMB-NEXT:    add sp, #8
; THUMB-NEXT:    pop {r4, pc}
; THUMB-NEXT:  .LBB10_2:
; THUMB-NEXT:    movs r0, #1
; THUMB-NEXT:    add sp, #8
; THUMB-NEXT:    pop {r4, pc}
entry:
  %safepoint_token = tail call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 0, i32 0, ptr elementtype(i1 ()) @return_i1, i32 0, i32 0, i32 0, i32 0) ["gc-live" (ptr addrspace(1) %a)]
  br i1 %external_cond, label %left, label %right

left:
  %call1 = call ptr addrspace(1) @llvm.experimental.gc.relocate.p1(token %safepoint_token,  i32 0, i32 0)
  %call2 = call zeroext i1 @llvm.experimental.gc.result.i1(token %safepoint_token)
  call void @consume(ptr addrspace(1) %call1)
  ret i1 %call2

right:
  ret i1 true
}

%struct2 = type { i64, i64, i64 }

declare void @consume_attributes(i32, ptr nest, i32, ptr byval(%struct2))

define void @test_attributes(ptr byval(%struct2) %s) gc "statepoint-example" {
; ARM-LABEL: test_attributes:
; ARM:       @ %bb.0: @ %entry
; ARM-NEXT:    .pad #16
; ARM-NEXT:    sub sp, sp, #16
; ARM-NEXT:    .save {r11, lr}
; ARM-NEXT:    push {r11, lr}
; ARM-NEXT:    .pad #24
; ARM-NEXT:    sub sp, sp, #24
; ARM-NEXT:    add r12, sp, #32
; ARM-NEXT:    stm r12, {r0, r1, r2, r3}
; ARM-NEXT:    add r0, sp, #32
; ARM-NEXT:    mov r1, sp
; ARM-NEXT:    vld1.32 {d16}, [r0]!
; ARM-NEXT:    mov r2, #17
; ARM-NEXT:    vst1.32 {d16}, [r1]!
; ARM-NEXT:    vld1.32 {d16}, [r0]!
; ARM-NEXT:    vst1.32 {d16}, [r1]!
; ARM-NEXT:    vld1.32 {d16}, [r0]!
; ARM-NEXT:    mov r0, #42
; ARM-NEXT:    vst1.32 {d16}, [r1]!
; ARM-NEXT:    mov r1, #0
; ARM-NEXT:    bl consume_attributes
; ARM-NEXT:  .Ltmp11:
; ARM-NEXT:    add sp, sp, #24
; ARM-NEXT:    pop {r11, lr}
; ARM-NEXT:    add sp, sp, #16
; ARM-NEXT:    bx lr
;
; THUMB-LABEL: test_attributes:
; THUMB:       @ %bb.0: @ %entry
; THUMB-NEXT:    .pad #16
; THUMB-NEXT:    sub sp, #16
; THUMB-NEXT:    .save {r7, lr}
; THUMB-NEXT:    push {r7, lr}
; THUMB-NEXT:    .pad #24
; THUMB-NEXT:    sub sp, #24
; THUMB-NEXT:    add.w r12, sp, #32
; THUMB-NEXT:    stm.w r12, {r0, r1, r2, r3}
; THUMB-NEXT:    add r0, sp, #32
; THUMB-NEXT:    mov r1, sp
; THUMB-NEXT:    vld1.32 {d16}, [r0]!
; THUMB-NEXT:    movs r2, #17
; THUMB-NEXT:    vst1.32 {d16}, [r1]!
; THUMB-NEXT:    vld1.32 {d16}, [r0]!
; THUMB-NEXT:    vst1.32 {d16}, [r1]!
; THUMB-NEXT:    vld1.32 {d16}, [r0]!
; THUMB-NEXT:    movs r0, #42
; THUMB-NEXT:    vst1.32 {d16}, [r1]!
; THUMB-NEXT:    movs r1, #0
; THUMB-NEXT:    bl consume_attributes
; THUMB-NEXT:  .Ltmp11:
; THUMB-NEXT:    add sp, #24
; THUMB-NEXT:    pop.w {r7, lr}
; THUMB-NEXT:    add sp, #16
; THUMB-NEXT:    bx lr
entry:
; Check that arguments with attributes are lowered correctly.
; We call a function that has a nest argument and a byval argument.
  %statepoint_token = call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 0, i32 0, ptr elementtype(void (i32, ptr, i32, ptr)) @consume_attributes, i32 4, i32 0, i32 42, ptr nest null, i32 17, ptr byval(%struct2) %s, i32 0, i32 0)
  ret void
}

