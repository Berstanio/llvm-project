define void @test_void_vararg() gc "statepoint-example" {
; Check a statepoint wrapping a *ptr returning vararg function works
; ARM-LABEL: test_void_vararg:
; ARM:       @ %bb.0: @ %entry
; ARM-NEXT:    .save {r11, lr}
; ARM-NEXT:    push {r11, lr}
; ARM-NEXT:    mov r0, #42
; ARM-NEXT:    mov r1, #43
; ARM-NEXT:    bl varargf
; ARM-NEXT:  .Ltmp7:
; ARM-NEXT:    pop {r11, pc}
;
; THUMB-LABEL: test_void_vararg:
; THUMB:       @ %bb.0: @ %entry
; THUMB-NEXT:    .save {r7, lr}
; THUMB-NEXT:    push {r7, lr}
; THUMB-NEXT:    movs r0, #42
; THUMB-NEXT:    movs r1, #43
; THUMB-NEXT:    bl varargf
; THUMB-NEXT:  .Ltmp7:
; THUMB-NEXT:    pop {r7, pc}
entry:
  %safepoint_token = tail call token (i64, i32, ptr, i32, i32, ...) @llvm.experimental.gc.statepoint.p0(i64 0, i32 0, ptr elementtype(void (i32, ...)) @varargf, i32 2, i32 0, i32 42, i32 43, i32 0, i32 0)
  ;; if we try to use the result from a statepoint wrapping a
  ;; non-void-returning varargf, we will experience a crash.
  ret void
}

