; ARM-NEXT:    push {r11, lr}
; ARM-NEXT:    .pad #8
; ARM-NEXT:    sub sp, sp, #8
; ARM-NEXT:    str r0, [sp, #4]
; ARM-NEXT:    bl return_i1
; ARM-NEXT:  .Ltmp6:
; ARM-NEXT:    add sp, sp, #8
; ARM-NEXT:    pop {r11, pc}
;
; THUMB-LABEL: test_relocate:
; THUMB:       @ %bb.0: @ %entry
; THUMB-NEXT:    .save {r7, lr}
; THUMB-NEXT:    push {r7, lr}
; THUMB-NEXT:    .pad #8
; THUMB-NEXT:    sub sp, #8
; THUMB-NEXT:    str r0, [sp, #4]
; THUMB-NEXT:    bl return_i1
; THUMB-NEXT:  .Ltmp6:
; THUMB-NEXT:    add sp, #8
; THUMB-NEXT:    pop {r7, pc}
entry:
